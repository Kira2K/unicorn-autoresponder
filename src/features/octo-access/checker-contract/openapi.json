{
  "openapi": "3.1.0",
  "info": {
    "title": "Proxy Checker API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/proxies/best": {
      "post": {
        "summary": "Get the best NodeMaven proxy for a required location",
        "operationId": "best_proxy_v1_proxies_best_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BestProxyInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BestProxyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proxies/check": {
      "post": {
        "summary": "Test exactly one supplied proxy",
        "operationId": "check_own_proxy_v1_proxies_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnProxyInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BestProxyInput": {
        "properties": {
          "unicorn_proxy_checker_secret_key": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "format": "password",
            "title": "Unicorn Proxy Checker Secret Key",
            "writeOnly": true
          },
          "api_key": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          },
          "location": {
            "$ref": "#/components/schemas/RequiredLocation"
          },
          "count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count",
            "default": 20
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unicorn_proxy_checker_secret_key",
          "api_key",
          "location"
        ],
        "title": "BestProxyInput",
        "examples": [
          {
            "api_key": "YOUR_NODEMAVEN_KEY",
            "count": 20,
            "location": {
              "city": "barcelona",
              "country": "es",
              "region": "catalunya"
            },
            "unicorn_proxy_checker_secret_key": "YOUR_SERVICE_KEY"
          }
        ]
      },
      "BestProxyResponse": {
        "properties": {
          "check_id": {
            "type": "string",
            "title": "Check Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "best_proxy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProxyResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "check_id",
          "status",
          "created_at"
        ],
        "title": "BestProxyResponse"
      },
      "CheckResponse": {
        "properties": {
          "check_id": {
            "type": "string",
            "title": "Check Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "best_proxy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProxyResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ProxyResult"
            },
            "type": "array",
            "title": "Results"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "check_id",
          "status",
          "created_at"
        ],
        "title": "CheckResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "HTTPErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "HTTPErrorDetail"
      },
      "HTTPErrorEnvelope": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/HTTPErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "HTTPErrorEnvelope"
      },
      "OwnProxyInput": {
        "properties": {
          "unicorn_proxy_checker_secret_key": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "format": "password",
            "title": "Unicorn Proxy Checker Secret Key",
            "writeOnly": true
          },
          "proxy": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "format": "password",
            "title": "Proxy",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unicorn_proxy_checker_secret_key",
          "proxy"
        ],
        "title": "OwnProxyInput",
        "examples": [
          {
            "proxy": "host.example.com:1080:login:password",
            "unicorn_proxy_checker_secret_key": "YOUR_SERVICE_KEY"
          }
        ]
      },
      "ProxyResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "proxy": {
            "type": "string",
            "title": "Proxy"
          },
          "proxy_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proxy Url"
          },
          "exit_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Ip"
          },
          "ip_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Type"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "location_matches": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Matches"
          },
          "median_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Ms"
          },
          "trust_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trust Score"
          },
          "latency_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Score"
          },
          "final_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Score"
          },
          "captcha": {
            "type": "string",
            "enum": [
              "detected",
              "not_detected",
              "unknown"
            ],
            "title": "Captcha",
            "default": "unknown"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "index",
          "proxy",
          "ok"
        ],
        "title": "ProxyResult"
      },
      "RequiredLocation": {
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[a-zA-Z]{2}$",
            "title": "Country"
          },
          "region": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Region",
            "description": "Exact NodeMaven catalogue code; preserved verbatim"
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "City",
            "description": "Exact NodeMaven catalogue code; preserved verbatim"
          },
          "zip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Zip"
          },
          "isp": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Isp"
          },
          "connection_type": {
            "type": "string",
            "enum": [
              "residential",
              "mobile"
            ],
            "title": "Connection Type",
            "default": "residential"
          },
          "ipv4_only": {
            "type": "boolean",
            "title": "Ipv4 Only",
            "default": false
          },
          "session_mode": {
            "type": "string",
            "enum": [
              "sticky",
              "rotating"
            ],
            "title": "Session Mode",
            "default": "sticky"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9]{1,32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 86400.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds"
          },
          "filter_mode": {
            "type": "string",
            "enum": [
              "quality",
              "quality_speed",
              "speed",
              "max_pool"
            ],
            "title": "Filter Mode",
            "default": "quality"
          },
          "norotate": {
            "type": "boolean",
            "title": "Norotate",
            "default": false
          },
          "protocol": {
            "type": "string",
            "enum": [
              "socks5",
              "http",
              "https"
            ],
            "title": "Protocol",
            "default": "socks5"
          },
          "port": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65535.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Port"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "country"
        ],
        "title": "RequiredLocation"
      },
      "ValidationIssue": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "type",
          "message"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}