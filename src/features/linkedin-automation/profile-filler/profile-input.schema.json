{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://very-evil-unicorn.local/schemas/linkedin-profile-v1.json",
  "title": "LinkedIn Profile Filler input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "$ref": "#/$defs/profile" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^(?:(?:19|20|21)[0-9]{2}|2200)-(0[1-9]|1[0-2])$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["skills", "experience", "education"],
      "properties": {
        "headline": { "type": "string" }, "about": { "type": "string" },
        "skills": { "$ref": "#/$defs/skills" },
        "experience": { "type": "array", "items": { "$ref": "#/$defs/experience" } },
        "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
        "open_to_work": { "$ref": "#/$defs/openToWork" }
      }
    },
    "skills": {
      "type": "object", "additionalProperties": false, "required": ["add", "target_count"],
      "properties": { "add": { "$ref": "#/$defs/stringList" }, "target_count": { "type": "integer", "minimum": 95, "maximum": 103 } }
    },
    "experience": {
      "type": "object", "additionalProperties": false, "required": ["action", "data"],
      "properties": { "action": { "const": "upsert" }, "match": { "$ref": "#/$defs/experienceMatch" }, "data": { "$ref": "#/$defs/experienceData" } }
    },
    "experienceMatch": {
      "type": "object", "additionalProperties": false,
      "properties": { "company": { "type": "string" }, "job_title": { "type": "string" }, "start_date": { "$ref": "#/$defs/date" } }
    },
    "experienceData": {
      "type": "object", "additionalProperties": false, "required": ["company", "job_title"],
      "properties": {
        "company": { "type": "string", "minLength": 1 }, "job_title": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "workplace_type": { "enum": ["ON_SITE", "HYBRID", "REMOTE"] },
        "start_date": { "$ref": "#/$defs/date" }, "end_date": { "$ref": "#/$defs/date" },
        "description": { "type": "string" },
        "source_of_hire": { "enum": ["INDEED", "LINKEDIN", "COMPANY_WEBSITE", "OTHER_JOB_SITES", "REFERRAL", "CONTACTED_BY_RECRUITER", "STAFFING_AGENCY", "OTHER"] },
        "skills": { "$ref": "#/$defs/stringList" }
      }
    },
    "education": {
      "type": "object", "additionalProperties": false, "required": ["action", "data"],
      "properties": { "action": { "const": "upsert" }, "match": { "$ref": "#/$defs/educationMatch" }, "data": { "$ref": "#/$defs/educationData" } }
    },
    "educationMatch": { "type": "object", "additionalProperties": false, "properties": { "school": { "type": "string" }, "start_date": { "$ref": "#/$defs/date" } } },
    "educationData": {
      "type": "object", "additionalProperties": false, "required": ["school"],
      "properties": {
        "school": { "type": "string", "minLength": 1 }, "degree": { "type": "string" },
        "field_of_study": { "type": "string" }, "start_date": { "$ref": "#/$defs/date" },
        "end_date": { "$ref": "#/$defs/date" }, "grade": { "type": "string" },
        "activities": { "type": "string" }, "description": { "type": "string" },
        "skills": { "$ref": "#/$defs/stringList" }
      }
    },
    "openToWork": {
      "type": "object", "additionalProperties": false,
      "required": ["job_titles", "workplace_types", "locations", "employment_types", "visibility"],
      "properties": {
        "job_titles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/parameter" }, "x-unipile-catalog": "JOB_TITLE" },
        "workplace_types": { "type": "array", "minItems": 1, "items": { "enum": ["ON_SITE", "HYBRID", "REMOTE"] }, "uniqueItems": true },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/parameter" }, "x-unipile-catalog": "LOCATION" },
        "start_date": { "enum": ["IMMEDIATELY", "FLEXIBLE"] },
        "employment_types": { "type": "array", "items": { "enum": ["FULL_TIME", "PART_TIME", "CONTRACT", "INTERNSHIP", "TEMPORARY"] }, "uniqueItems": true },
        "visibility": { "enum": ["ALL", "RECRUITERS_ONLY"] }
      }
    }
  }
}
